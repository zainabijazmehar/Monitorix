# ==============================
# MONITORIX - Git Ignore
# ==============================


# ------------------------------
# Environment Variables / Secrets
# ------------------------------
.env
.env.*
!.env.example


# ------------------------------
# Python Cache Files
# ------------------------------
__pycache__/
*.py[cod]
*$py.class

# Python build files
build/
dist/
*.egg-info/
.eggs/


# ------------------------------
# Virtual Environments
# ------------------------------
.venv/
venv/
env/
ENV/


# ------------------------------
# Logs
# ------------------------------
logs/
*.log


# ------------------------------
# Database Files
# ------------------------------
*.db
*.sqlite
*.sqlite3

# Database backups
*.db.backup
*.sqlite.backup


# ------------------------------
# Reports Generated by Monitorix
# ------------------------------
reports/
*.pdf
*.html


# ------------------------------
# Backup & Restore Data
# ------------------------------
backups/
backup/
*.bak


# ------------------------------
# Cache / Temporary Files
# ------------------------------
.cache/
.tmp/
tmp/
temp/

*.tmp
*.temp


# ------------------------------
# Discord / Bot Runtime Files
# ------------------------------
sessions/
tokens/
*.token


# ------------------------------
# IDE Settings
# ------------------------------
.vscode/
.idea/

*.swp
*.swo


# ------------------------------
# Operating System Files
# ------------------------------
# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store


# ------------------------------
# Testing Files
# ------------------------------
.pytest_cache/
.coverage
htmlcov/


# ------------------------------
# Jupyter / Notebook
# ------------------------------
.ipynb_checkpoints/


# ------------------------------
# Security / Sensitive Data
# ------------------------------
*.pem
*.key
*.crt
secrets/


# ------------------------------
# Packaging
# ------------------------------
pip-wheel-metadata/
*.manifest
*.spec